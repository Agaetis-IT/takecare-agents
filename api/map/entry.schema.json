{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agaetis-it/takecare-agents/api/map/entry.schema.json",
  "title": "TakeCare Map entry",
  "description": "One entry of the Map, one file per entity at map/<type>/<name>.yaml (spec 08 §3-4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "provenance", "status", "created"],
  "properties": {
    "key": { "$ref": "#/$defs/key" },
    "provenance": {
      "description": "declared: written by a human; discovered: found by the deterministic discovery; proposed: suggested by an agent.",
      "enum": ["declared", "discovered", "proposed"]
    },
    "status": {
      "description": "Only validated entries are used for routing and scope.",
      "enum": ["proposed", "validated"]
    },
    "created": { "$ref": "#/$defs/date" },
    "lastValidated": { "$ref": "#/$defs/date" },
    "lastSeen": { "$ref": "#/$defs/date" },
    "owner": {
      "description": "The team that answers for the entry, a team key.",
      "type": "string",
      "pattern": "^team/[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "description": { "type": "string", "maxLength": 500 },
    "sources": {
      "description": "The cloud or cluster identifiers the entry maps to, one kind per item.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "maxProperties": 1,
        "properties": {
          "kubernetes": {
            "type": "string",
            "description": "[<cluster>/]<namespace>[/<Kind>/<name>]: a namespace or an object in it, on the unnamed cluster, or prefixed by a named cluster (a DNS label, ADR 0016); the segments' count tells them apart",
            "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?/)?[a-z0-9]([-a-z0-9]*[a-z0-9])?(/[^/]+/[^/]+)?$"
          },
          "azure": { "type": "string", "minLength": 1 },
          "aws": { "type": "string", "minLength": 1 },
          "vsphere": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "knowledge": {
            "type": "string",
            "description": "<connector>/<recordId>: the record of a knowledge connector a runbook entry maps to (spec 08 §3)",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?/[^/\\s]+$"
          }
        }
      }
    },
    "relations": {
      "description": "Relations declared on the entry they start from (spec 08 §2).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependsOn": { "$ref": "#/$defs/keys" },
        "runsAs": { "$ref": "#/$defs/keys" },
        "belongsTo": { "$ref": "#/$defs/keys" },
        "deployedIn": { "$ref": "#/$defs/keys" },
        "observedBy": { "$ref": "#/$defs/keys" },
        "documentedBy": { "$ref": "#/$defs/keys" },
        "alertedBy": {
          "description": "The alerts that fire on the entry, as the alert source names them: a name, or {name, expr} with the alert's expression (spec 08 §4).",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/alertName" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "expr"],
                "properties": {
                  "name": { "$ref": "#/$defs/alertName" },
                  "expr": { "type": "string", "minLength": 1, "maxLength": 4096 }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "key": {
      "description": "type/name, with one of the eleven entity types.",
      "type": "string",
      "maxLength": 253,
      "pattern": "^(service|compute|datastore|storage|network|identity|external|team|environment|observability|runbook)/[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "keys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    },
    "alertName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
