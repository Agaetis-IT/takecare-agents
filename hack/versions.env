# TakeCare Agents: every pinned third-party version, and nothing else (spec 04).
# Included by the Makefile, read by the CI and, from PR 3, by the charts.
# KEY=VALUE only, no quotes, no spaces: the file is valid for make and for sh.
# No floating tag and no `latest`. A bump is one PR with a green CI (ADR 0002).

# --- Images we build (spec 04) ---
# Registry for v1.0. Customer-internal registries: chart values
# global.imageRegistry and global.imagePullSecrets (ADR 0002).
IMAGE_REGISTRY=ghcr.io/agaetis-it
# Multi-arch: demos run on Apple Silicon.
IMAGE_PLATFORMS=linux/amd64,linux/arm64
GO_BUILD_IMAGE=golang:1.27.1-bookworm@sha256:8d48e12ec56735e9358640898b9d9b9fcca110612ed8a5567438c0a1baa24e66
RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

# --- Cluster (demo, e2e and the chart smoke run) ---
# As validated by spike 001. ADR 0010 (Proposed) would raise the floor to 1.37.
K3S_IMAGE=rancher/k3s:v1.36.5-k3s1
# k3d, downloaded by the CI with its checksum (release asset checksums.txt).
K3D_VERSION=v5.9.0
K3D_SHA256_LINUX_AMD64=06d8f25bc3a971c4eb29e0ff08429b180402db0f4dec838c9eac427e296800a0
K3D_SHA256_DARWIN_ARM64=fe106541d5d0a3f18debcd4d432a16f8c0ce3e6ddc06f8fbb6f696a122313e00
# Test pod of hack/chart-smoke.sh (curl against the gateway and the engine).
SMOKE_CURL_IMAGE=curlimages/curl:8.23.0@sha256:3fb7e13e5d179a845c97d78204f3f1064d1907037f26a3ebf91710571151fd93

# --- Gateway (ADR 0002, 0004, 0008, 0009) ---
# Upstream Gateway API CRDs, standard channel, applied server-side by the
# takecare-crds hook job from the copy embedded in the operator binary
# (internal/gatewayapi/standard-install.yaml). The checksum is the release
# asset's; a test checks the embedded copy against both values.
GATEWAY_API_VERSION=v1.6.1
GATEWAY_API_CHANNEL=standard
GATEWAY_API_INSTALL_SHA256=24d931f22abd8e40c973264319ead7cfa09d0fb7716b7ab1ee2ff174cb063a73
# Validated by spike 001 (move to the 1.6 line decided on 2026-10-13, ADR 0002).
AGENTGATEWAY_VERSION=v1.6.0

# --- Prometheus Operator's AlertmanagerConfig CRD (spec 02 §1) ---
# The chart renders an AlertmanagerConfig when the customer's cluster serves
# it; TakeCare installs nothing of Prometheus Operator. test/chart validates
# the rendered object against this CRD, vendored at
# test/chart/testdata/monitoring.coreos.com_alertmanagerconfigs.yaml from
# example/prometheus-operator-crd/ of the release; a test checks the copy.
PROMETHEUS_OPERATOR_VERSION=v0.94.1
PROMETHEUS_OPERATOR_AMCONFIG_CRD_SHA256=f3ae40001f979ef4d922a25610b8e72ae74b11453329641c0d2a7b712879c504

# --- Agent engine: kagent 0.10.3 (ADR 0007, confirmed by spike 001) ---
# Charts oci://ghcr.io/kagent-dev/kagent/helm/{kagent,kagent-crds}. The chart
# only pins the controller and UI images by tag (no digest value), so the
# digests below are the registry's index digests recorded by the spike for
# the cluster that ran every measure (report, section 13): what to check
# against a pod's imageID, not what the chart consumes.
KAGENT_VERSION=0.10.3
KAGENT_CHART_DIGEST=sha256:2f355400c760116e830cd7e86e7046477d480fb7dc309131832c51d65dfe9063
KAGENT_CRDS_CHART_DIGEST=sha256:76582530f0b58b48575d19936e19d790ca2cea8e0421775be65bd4c99b2d8da0
KAGENT_CONTROLLER_DIGEST=sha256:b2572a59386b6bac1f5e652e135fdad54c0ee603d3f9ee60eb7c80bbaedf9b76
KAGENT_UI_DIGEST=sha256:13f62914b66e19d394eea5fe04db85f689457ad582ef6b2ebd3bb44ec01a1127
KAGENT_APP_DIGEST=sha256:9a41ef053b264630ae078d2d2c7c72a85d5d77e6b2ce392169006f84055dacfb
KAGENT_GOLANG_ADK_DIGEST=sha256:5ee9592cb7d959538d0f0fe36acf31ba3a06de084f84048b1459c3bdfafcda1f

# --- MCP servers (ADR 0008, validated by spike 001), pinned by digest ---
# mcp-prometheus image tags have no "v". The digests are the registries'
# manifest list digests on 2026-10-29.
KUBERNETES_MCP_SERVER_IMAGE=quay.io/containers/kubernetes_mcp_server:v0.0.67@sha256:e47f6ccc5347e1ea6be495d8d9ab55ac8a995fe87800fb984fa770cebe14ad44
MCP_PROMETHEUS_IMAGE=gsoci.azurecr.io/giantswarm/mcp-prometheus:0.11.11@sha256:66ad2ff739eefed93ce0b90ed06d9c0fd4ef9ad38a417f57843b683c4c5df18e

# --- Observability and alerting (demo profile, validated by spike 001) ---
PROMETHEUS_CHART_VERSION=29.37.0
OTEL_COLLECTOR_CHART_VERSION=0.176.0
JAEGER_IMAGE=jaegertracing/jaeger:2.22.0

# --- Demo scenery (spec 03) ---
PYTHON_IMAGE=python:3.12.13-slim
FASTMCP_VERSION=3.4.9

# --- Charts (ADR 0002): Helm 4 is the supported line, pinned with its checksums.
# Helm 3 stopped receiving bug fixes on 2026-09-09 and stops receiving security
# fixes on 2027-02-10; the charts stay apiVersion v2 without Helm 4-only
# features, so Helm 3 still installs them until then, unsupported.
HELM_VERSION=v4.3.1
HELM_SHA256_LINUX_AMD64=0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b
HELM_SHA256_LINUX_ARM64=8cf8f66ecbc252ac8f7f06cca68aba88508ddfde3a6a34feb1678ad1694b4f88
HELM_SHA256_DARWIN_AMD64=34bec4eba761ba5c16d1965ee6b8f5b0abe5993974a802274e2a4f0418893d89
HELM_SHA256_DARWIN_ARM64=6b4e61c8cd27d99e5a801e63ff25dd5c70b36875c2cd659d3e9ce6b76fc23198
KUBECONFORM_VERSION=v0.8.0
KUBECONFORM_SHA256_LINUX_AMD64=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883
KUBECONFORM_SHA256_LINUX_ARM64=1f53fc8e81258197a35e8603054162a5af1de8c5af13746c71ab680d9534ed87
KUBECONFORM_SHA256_DARWIN_AMD64=71dbc87ac9f24099a62b93570e65aa06312ba6ac8aea63b7f86e9d999edf5a92
KUBECONFORM_SHA256_DARWIN_ARM64=f84f4dfbebf4a6b0b230385fa065a39ea35e02608c2b50d025dcf64775a69d67

# --- Development tools (Go tools are installed into ./bin) ---
# controller-tools and golangci-lint at the versions kubebuilder v4.16.0 ships.
CONTROLLER_TOOLS_VERSION=v0.22.0
GOLANGCI_LINT_VERSION=v2.13.1
SETUP_ENVTEST_VERSION=v0.25.2
# Matches the k8s.io client libraries in go.mod.
ENVTEST_K8S_VERSION=1.37.0
GO_LICENSES_VERSION=v2.0.1
# Non-Go linters run from pinned images: same binary locally and in CI.
RUFF_IMAGE=ghcr.io/astral-sh/ruff:0.17.1@sha256:eae3102808b46de58204237a3433001cae4d45d832f31be1c8121f7145a62661
SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0@sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d
HELM_DOCS_IMAGE=jnorwood/helm-docs:v1.14.2@sha256:7e562b49ab6b1dbc50c3da8f2dd6ffa8a5c6bba327b1c6335cc15ce29267979c
MARKDOWNLINT_IMAGE=davidanson/markdownlint-cli2:v0.23.3@sha256:d5f3f3f04b2e285dcbcdcd13b4454d119e273e3c393a9dabd163dba4abad526d
GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
