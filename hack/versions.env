# TakeCare Agents: every pinned third-party version, and nothing else (spec 04).
# Included by the Makefile, read by the CI and, from PR 3, by the charts.
# KEY=VALUE only, no quotes, no spaces: the file is valid for make and for sh.
# No floating tag and no `latest`. A bump is one PR with a green CI (ADR 0002).

# --- Images we build (spec 04) ---
# Registry for v1.0. Customer-internal registries: chart values
# global.imageRegistry and global.imagePullSecrets (ADR 0002).
IMAGE_REGISTRY=ghcr.io/agaetis-it
# Multi-arch: demos run on Apple Silicon.
IMAGE_PLATFORMS=linux/amd64,linux/arm64
GO_BUILD_IMAGE=golang:1.27.1-bookworm@sha256:8d48e12ec56735e9358640898b9d9b9fcca110612ed8a5567438c0a1baa24e66
RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

# --- Cluster (demo and e2e) ---
# As validated by spike 001. ADR 0010 (Proposed) would raise the floor to 1.37.
K3S_IMAGE=rancher/k3s:v1.36.5-k3s1

# --- Gateway (ADR 0002, 0004, 0008, 0009) ---
# Upstream Gateway API CRDs, standard channel, applied server-side.
GATEWAY_API_VERSION=v1.6.1
GATEWAY_API_CHANNEL=standard
# Validated by spike 001 (move to the 1.6 line decided on 2026-10-13, ADR 0002).
AGENTGATEWAY_VERSION=v1.6.0

# --- Agent engine ---
# Deliberately absent. The engine and its version are decided by ADR 0007 and
# ADR 0010 (Proposed, port suspended) on spike 001's results. Nothing in the
# product may assume an engine until then.

# --- MCP servers (ADR 0008, validated by spike 001) ---
# mcp-prometheus image tags have no "v".
KUBERNETES_MCP_SERVER_IMAGE=quay.io/containers/kubernetes_mcp_server:v0.0.67
MCP_PROMETHEUS_IMAGE=gsoci.azurecr.io/giantswarm/mcp-prometheus:0.11.11

# --- Observability and alerting (demo profile, validated by spike 001) ---
PROMETHEUS_CHART_VERSION=29.37.0
OTEL_COLLECTOR_CHART_VERSION=0.176.0
JAEGER_IMAGE=jaegertracing/jaeger:2.22.0

# --- Demo scenery (spec 03) ---
PYTHON_IMAGE=python:3.12.13-slim
FASTMCP_VERSION=3.4.9

# --- Development tools (Go tools are installed into ./bin) ---
# controller-tools and golangci-lint at the versions kubebuilder v4.16.0 ships.
CONTROLLER_TOOLS_VERSION=v0.22.0
GOLANGCI_LINT_VERSION=v2.13.1
SETUP_ENVTEST_VERSION=v0.25.2
# Matches the k8s.io client libraries in go.mod.
ENVTEST_K8S_VERSION=1.37.0
GO_LICENSES_VERSION=v2.0.1
# Non-Go linters run from pinned images: same binary locally and in CI.
RUFF_IMAGE=ghcr.io/astral-sh/ruff:0.17.1@sha256:eae3102808b46de58204237a3433001cae4d45d832f31be1c8121f7145a62661
SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0@sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d
MARKDOWNLINT_IMAGE=davidanson/markdownlint-cli2:v0.23.3@sha256:d5f3f3f04b2e285dcbcdcd13b4454d119e273e3c393a9dabd163dba4abad526d
GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
