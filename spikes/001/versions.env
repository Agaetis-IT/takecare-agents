# Spike 001 — every pinned version, and nothing else.
# Sourced by the Makefile and the scripts. Resolved on 2026-10-17 from each
# project's releases; see docs/spikes/001-kagent-doc-engine-report.md.
# No floating tag and no `latest` anywhere in the spike.

# Cluster
K3S_IMAGE=rancher/k3s:v1.36.5-k3s1
# API server event TTL (default 1h). Events of earlier scenarios otherwise
# pile up in demo-apps and change what `events_list` returns, hence the token
# volume of every investigation (stage 4). 10 min > the longest time to alert
# (~7.5 min); recurring events (BackOff, probe failures) are rewritten and stay.
EVENT_TTL=10m

# Gateway (ADR 0004, 0008, 0009)
AGENTGATEWAY_VERSION=v1.6.0
# Upstream Gateway API CRDs, applied server-side (not from agentgateway's
# chart). Standard channel v1.6.1, as pinned by ADR 0002: the spike only uses
# Gateway and HTTPRoute; MCP and A2A backends are agentgateway's own CRDs.
# (agentgateway v1.6.0's go.mod builds against v1.6.2.)
GATEWAY_API_VERSION=v1.6.1
GATEWAY_API_CHANNEL=standard

# Agent engine under test (ADR 0007)
KAGENT_VERSION=0.10.3

# Baseline engine
HOLMES_CHART_VERSION=0.45.0

# MCP servers (release v0.0.67 and v0.11.11; mcp-prometheus image tags have no "v")
KUBERNETES_MCP_SERVER_IMAGE=quay.io/containers/kubernetes_mcp_server:v0.0.67
MCP_PROMETHEUS_IMAGE=gsoci.azurecr.io/giantswarm/mcp-prometheus:0.11.11

# Observability and alerting
PROMETHEUS_CHART_VERSION=29.37.0
OTEL_COLLECTOR_CHART_VERSION=0.176.0
JAEGER_IMAGE=jaegertracing/jaeger:2.22.0

# A2A client used by the trigger (Go module)
A2A_GO_VERSION=v2.6.0

# Model (same for every engine), routed through agentgateway
MODEL=google/gemini-3.7-flash

# Scenery: demo apps (code mounted from ConfigMaps) and the corpus MCP servers
PYTHON_IMAGE=python:3.12.13-slim
FASTMCP_VERSION=3.4.9
