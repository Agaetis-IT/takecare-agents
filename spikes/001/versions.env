# Spike 001 — every pinned version, and nothing else.
# Sourced by the Makefile and the scripts. Resolved on 2026-10-17 from each
# project's releases; see docs/spikes/001-kagent-doc-engine-report.md.
# No floating tag and no `latest` anywhere in the spike.

# Cluster
K3S_IMAGE=rancher/k3s:v1.36.5-k3s1
# API server event TTL (default 1h). Earlier scenarios' events are purged at
# every scenario start (scenario.sh); the TTL only has to keep the current
# incident's events stable for the whole series of runs on it. 30 min > one
# scenario's series in stage 6. A 10 min TTL made proxy-timeout's events
# expire mid-incident (2,444 chars at the alert, empty 12 min later).
EVENT_TTL=30m
# Kubernetes feature gates kagent 1.0's Substrate needs (pod certificates and
# trust bundles), as in kagent's own kind config (scripts/kind/kind-config.yaml).
K8S_FEATURE_GATES=ClusterTrustBundle=true,ClusterTrustBundleProjection=true,PodCertificateRequest=true

# Gateway (ADR 0004, 0008, 0009)
AGENTGATEWAY_VERSION=v1.6.0
# Upstream Gateway API CRDs, applied server-side (not from agentgateway's
# chart). Standard channel v1.6.1, as pinned by ADR 0002: the spike only uses
# Gateway and HTTPRoute; MCP and A2A backends are agentgateway's own CRDs.
# (agentgateway v1.6.0's go.mod builds against v1.6.2.)
GATEWAY_API_VERSION=v1.6.1
GATEWAY_API_CHANNEL=standard

# Agent engine under test (ADR 0007, ADR 0010): the kagent 1.0 line.
# Installed by kagent's own CLI (`kagent install`), which also installs
# Substrate (agents run as Substrate actors), its pod-certificate controller
# and a bundled PostgreSQL. The CLI binary is pinned by its release checksum.
KAGENT_VERSION=1.0.0-alpha14
KAGENT_CLI_SHA256_DARWIN_ARM64=66a8118ba3e6627fef00d91b3fb9afc62ae065acdda533e1868c0f8e4a66f786
SUBSTRATE_VERSION=0.5.0-alpha2
# Before the move (context only, manifests/kagent-0.10.3/): kagent 0.10.3.
KAGENT_0103_VERSION=0.10.3

# Baseline engine
HOLMES_CHART_VERSION=0.45.0

# MCP servers (release v0.0.67 and v0.11.11; mcp-prometheus image tags have no "v")
KUBERNETES_MCP_SERVER_IMAGE=quay.io/containers/kubernetes_mcp_server:v0.0.67
MCP_PROMETHEUS_IMAGE=gsoci.azurecr.io/giantswarm/mcp-prometheus:0.11.11

# Observability and alerting
PROMETHEUS_CHART_VERSION=29.37.0
OTEL_COLLECTOR_CHART_VERSION=0.176.0
JAEGER_IMAGE=jaegertracing/jaeger:2.22.0

# A2A client used by the trigger (Go module)
A2A_GO_VERSION=v2.6.0

# Model (same for every engine), routed through agentgateway
MODEL=google/gemini-3.7-flash

# Scenery: demo apps (code mounted from ConfigMaps) and the corpus MCP servers
PYTHON_IMAGE=python:3.12.13-slim
FASTMCP_VERSION=3.4.9

# Homemade engine (ADR 0007 fallback, measured as a third engine): the three
# libraries ADR 0007 names, pinned in engine/go.mod, and the build images.
ADK_GO_VERSION=v2.5.0
MCP_GO_SDK_VERSION=v1.8.0
GO_BUILD_IMAGE=golang:1.27.1-bookworm@sha256:8d48e12ec56735e9358640898b9d9b9fcca110612ed8a5567438c0a1baa24e66
ENGINE_RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
DOC_ENGINE_IMAGE=spike001/doc-engine:0.1.0
