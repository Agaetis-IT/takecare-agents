# Ignore everything, then re-include only what the operator build needs.
**
!go.mod
!go.sum
!cmd/**/*.go
!api/**/*.go
!internal/**/*.go
# The end-to-end fakes, built into test-only images.
!test/fakellm/*.go
!test/fakeslack/*.go
**/*_test.go
!internal/gatewayapi/standard-install.yaml
# Files the binaries embed (go:embed).
!internal/doc/instructions.md
!internal/doc/message.tmpl
!internal/demo/corpus/pools.json
!internal/demo/corpus/seed/*.json
